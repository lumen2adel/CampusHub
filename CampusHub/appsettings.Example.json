{
  // Reference only: this file is not loaded by the app.
  // Every key below that is missing from appsettings.json must be supplied as a secret:
  //   dotnet user-secrets set "jwt:Secret" "<value>"          (development)
  //   jwt__Secret=<value>                                       (environment variable; ':' becomes '__')
  "ConnectionStrings": {
    "DataContext": "Host=localhost;Port=5432;Database=campushub;Username=postgres;Password=<your-db-password>"
  },
  "jwt": {
    "Secret": "<random string, at least 32 characters>",
    "ExpireDays": 7,
    "Issuer": "CampusHub",
    "Audience": "CampusHub"
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Email": "<sender address>",
    "Password": "<SMTP app password>",
    "DisplayName": "CampusHub",
    "Port": 587
  },
  "Captcha": {
    "SecretKey": "<Google reCAPTCHA secret key>"
  }
}
